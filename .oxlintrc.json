{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // React Compiler rules, which this app does not use. `purity` flags the
    // clock reads that date today's stats on purpose; `refs` flags the menu's
    // trigger props being spread onto the button that owns their ref.
    "react/purity": "off",
    "react/refs": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "roles": ["group", "tabpanel"]
      }
    ]
  },
  "ignorePatterns": ["dist", "coverage", "node_modules", "skills/*/scripts/*.mjs"]
}
