{
  "name": "basilico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first focus timer with tasks, alerts and real statistics.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @basilico/web dev",
    "build": "pnpm --filter @basilico/web build",
    "build:skill": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check",
    "preview": "pnpm --filter @basilico/web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  }
}
